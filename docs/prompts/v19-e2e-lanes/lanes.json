  "lanes": [
    {
      "id": "01-state-integration-captain",
      "title": "State Model / Integration Captain",
      "mission": "Own the shared Submission state model, reconcile all lane findings against it, and block any fake PASS or local exception that bypasses domain ownership.",
      "owns": [
        "docs/architecture/v19-flow-state-model.md",
        "final state/readiness verdict"
      ],
      "mustNotTouch": [
        "runtime code before reading all lane evidence",
        "agent/admin/export UI implementation unless reconciling a verified cross-lane conflict",
        "git commit/push/merge/rebase/deploy"
      ],
      "checks": [
        "git status --short --branch",
        "npm run typecheck",
        "npm run verify:v19-boundary",
        "verify every PASS claim maps back to docs/architecture/v19-flow-state-model.md"
      ]
    },
    {
      "id": "02-agent-flow-state",
      "title": "Agent Flow Around State",
      "mission": "Prove and fix agent create/submission/correction behavior as command dispatch around the shared Submission state model.",
      "owns": [
        "agent empty state",
        "single and family creation",
        "required validation",
        "agent drawer commands",
        "returned correction visibility",
        "mark fixed and resubmit flow"
      ],
      "mustNotTouch": [
        "admin export contract",
        "PDF handoff internals",
        "Supabase schema",
        "global visual redesign"
      ],
      "checks": [
        "npm run test -- tests/unit/v19DomainEngine.spec.ts",
        "targeted Playwright proof for create single/family and correction resubmit",
        "fresh desktop and mobile runtime assertions; optional screenshots stay in V19_TEST_ARTIFACTS_DIR"
      ]
    },
    {
      "id": "03-admin-review-pdf-state",
      "title": "Admin Review + PDF Around State",
      "mission": "Prove and fix admin review, issue closure, acceptance blocking, and PDF handoff truth without moving decisions into React.",
      "owns": [
        "admin review queue",
        "return with issue",
        "close fixed issue",
        "accept valid submission",
        "PDF panel states",
        "admin-to-agent PDF claim classification"
      ],
      "mustNotTouch": [
        "Excel workbook row contract",
        "agent create drawer",
        "global UI redesign",
        "Supabase schema"
      ],
      "checks": [
        "npm run test -- tests/unit/v19DomainEngine.spec.ts tests/unit/visaApplicationPdfReconciliation.spec.ts tests/unit/pdfTextExtraction.spec.ts",
        "targeted Playwright proof for admin review/correction/PDF panel",
        "artifact hash/MIME/name proof when claiming real PDF artifact"
      ]
    },
    {
      "id": "04-export-click-mobile-verifier",
      "title": "Export + Click/Mobile Verifier",
      "mission": "Prove export integrity, complete the click inventory, close mobile proof gaps, and independently challenge all evidence against the shared state model.",
      "owns": [
        "Excel preview and workbook parity",
        "parsed XLSX proof",
        "mark-exported identity gate",
        "desktop click inventory",
        "390x844 and 430x932 mobile proof",
        "final verifier notes"
      ],
      "mustNotTouch": [
        "agent creation internals unless reporting a verified bug",
        "admin PDF internals unless reporting a verified bug",
        "business lifecycle logic without updating the state-model artifact"
      ],
      "checks": [
        "npm run test -- tests/unit/exportWorkbook.spec.ts tests/unit/submissionExportWorkflow.spec.ts",
        "npx playwright test tests/e2e/app-smoke.spec.ts --project=chromium -g \"export\"",
        "npx playwright test tests/e2e/v19-responsive-proof.spec.ts --project=chromium",
        "record BUG/BLOCKED rows in the external lane manifest"
      ]
    }
