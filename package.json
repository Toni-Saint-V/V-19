{
  "name": "visaflow-ai-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "VITE_SUPABASE_BACKEND_TARGET=local-demo VITE_SUPABASE_SANDBOX_PROBE_ENABLED=false vitest run tests/unit tests/integration",
    "test:supabase-live": "VITEST_SUPABASE_LIVE=1 vitest run tests/integration/supabase-live.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "playwright test --config playwright.supabase.config.ts",
    "verify:performance": "node scripts/verify-performance.mjs",
    "verify:v19-ui-proof": "playwright test tests/e2e/v19-accessibility.spec.ts tests/e2e/v19-responsive-proof.spec.ts tests/e2e/v19-ux-states.spec.ts --project=chromium",
    "verify:safety": "node scripts/verify-safety.mjs",
    "verify:codex-hook": "node scripts/verify-codex-hook.mjs",
    "verify:agent-screen-system": "node scripts/verify-agent-screen-system.mjs",
    "verify:v19-boundary": "node scripts/verify-v19-boundary.mjs",
    "verify:supabase-release": "node scripts/verify-supabase-release.mjs",
    "verify:auth-data-readiness": "node scripts/verify-auth-data-readiness.mjs",
    "supabase:prepare-production": "node scripts/prepare-supabase-production-packet.mjs",
    "supabase:pilot-cohort": "node scripts/provision-supabase-pilot-cohort.mjs",
    "supabase:production-workflow-smoke": "node scripts/verify-supabase-production-workflow.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "verify:production-packet": "node scripts/verify-production-readiness.mjs --expect-blocked",
    "verify:security": "npm audit --omit=dev",
    "v19:e2e:lanes": "node scripts/launch-v19-parallel-e2e.mjs",
    "v19:e2e:4": "node scripts/launch-v19-parallel-e2e.mjs --allow-dirty-source",
    "verify": "npm run typecheck && npm run lint && npm run verify:safety && npm run verify:codex-hook && npm run verify:agent-screen-system && npm run verify:v19-boundary && npm run verify:v19-ui-proof && npm run test && npm run build && npm run verify:performance",
    "verify:local-readiness": "npm run verify && npm run verify:security && npm run test:e2e",
    "verify:full": "npm run verify:local-readiness && npm run verify:auth-data-readiness && npm run verify:supabase-release && npm run verify:production-packet"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
